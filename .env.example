# DeepAuto Agent's Feishu/Lark bot credentials.
# Copy this file to .env.local and fill in the values locally.
# Never commit .env.local or any real credential.
LARK_APP_ID=
LARK_APP_SECRET=

# Optional: used by the message runtime after the bot identity is resolved.
LARK_BOT_OPEN_ID=

# Optional: set after the local user OAuth flow is complete.
LARK_USER_OPEN_ID=

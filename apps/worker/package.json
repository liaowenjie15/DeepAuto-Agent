{
  "name": "@deepauto/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "bun dist/main.js",
    "lint": "biome check src package.json tsconfig.json tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "bun test src"
  },
  "dependencies": {
    "@deepauto/agent-core": "workspace:*",
    "@deepauto/contracts": "workspace:*",
    "@deepauto/db": "workspace:*",
    "@deepauto/github": "workspace:*",
    "@deepauto/lark": "workspace:*",
    "@deepauto/runner-manager": "workspace:*",
    "bullmq": "5.78.0",
    "dotenv": "17.4.2",
    "ioredis": "5.10.1",
    "zod": "4.4.3"
  }
}

{
  "name": "deepauto-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "22.23.3",
    "bun": "1.4.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint && biome check package.json biome.json turbo.json tsconfig.base.json apps packages",
    "lint:fix": "turbo lint:fix && biome check . --write",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/node": "25.9.2",
    "dotenv": "17.4.2",
    "turbo": "2.11.9",
    "typescript": "5.9.3"
  },
  "trustedDependencies": [
    "@prisma/engines",
    "prisma"
  ]
}

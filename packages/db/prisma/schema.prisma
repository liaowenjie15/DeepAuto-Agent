generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InvocationSource {
  FEISHU
  GITHUB
}

enum InvocationAnchor {
  MESSAGE
  ISSUE
  PULL_REQUEST
  COMMENT
}

enum LarkDeliveryState {
  PENDING
  CLAIMED
  SENT
  UNKNOWN
}

enum LarkProcessingState {
  QUEUED
  CLAIMED
  WAITING_PR
  COMPLETED
  FAILED
  UNKNOWN
}

enum LarkChatType {
  P2P
  GROUP
}

enum LarkToolOperationState {
  CLAIMED
  SUCCEEDED
  UNKNOWN
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AttemptStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum OutboxEventKind {
  JOB_ENQUEUE
  EXECUTION_CANCEL
  EXECUTION_CONVERSATION_RELEASE
}

enum ExecutionCancellationRequestStatus {
  REQUESTED
  DISPATCHED
  FAILED
  COMPLETED
  SUPERSEDED
}

enum MemberRole {
  MEMBER
  OPERATOR
  ADMIN
}

enum CredentialProvider {
  LARK_USER
  GITHUB_INSTALLATION
}

enum ExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum ExecutionFailureCategory {
  VALIDATION_FAILED
  POLICY_REJECTED
  CANCELLED
  TIMEOUT
  INFRASTRUCTURE_FAILED
  CALLBACK_REJECTED
}

enum ExecutionLogProvider {
  GITHUB_ACTIONS
  LOCAL_SANDBOX
}

enum ExecutionEventType {
  STARTED
  PROGRESS
  ARTIFACT
  COMPLETED
  FAILED
}

enum ExecutionArtifactName {
  DIFF
  TEST_RESULT
  COMMIT_SHA
  PULL_REQUEST
  PROMPT_LAYERS
  WORKSPACE
}

model Workspace {
  id        String            @id
  createdAt DateTime          @default(now())
  members   WorkspaceMember[]
  repositories WorkspaceRepository[]
}

model WorkspaceMember {
  id           String     @id @default(cuid())
  workspaceId  String
  role         MemberRole @default(MEMBER)
  active       Boolean    @default(true)
  larkOpenId   String?
  githubUserId String?
  githubLogin  String?
  createdAt    DateTime   @default(now())
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  larkConnections LarkUserConnection[]
  larkOAuthStates LarkOAuthState[]
  larkWriteConfirmations LarkWriteConfirmation[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, larkOpenId])
  @@unique([workspaceId, githubUserId])
}

model LarkOAuthState {
  stateHash   String   @id
  workspaceId String
  actorId     String
  tenantKey   String
  scopes      String[]
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  member      WorkspaceMember @relation(fields: [actorId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([expiresAt])
}

model LarkUserConnection {
  id                     String          @id @default(cuid())
  workspaceId            String
  actorId                String
  appId                  String
  tenantKey              String
  openId                 String
  accessTokenEncrypted   String
  refreshTokenEncrypted  String
  accessExpiresAt        DateTime
  refreshExpiresAt       DateTime
  refreshUncertainAt     DateTime?
  scopes                 String[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  member                 WorkspaceMember @relation(fields: [actorId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([workspaceId, actorId, appId, tenantKey])
  @@index([workspaceId, tenantKey])
}

model LarkWriteConfirmation {
  id              String   @id @default(cuid())
  workspaceId     String
  actorId         String
  appId           String
  tenantKey       String
  conversationKey String
  action          String
  targetHash      String
  payloadHash     String
  expiresAt       DateTime
  consumedAt      DateTime?
  invalidatedAt   DateTime?
  createdAt       DateTime @default(now())
  member          WorkspaceMember @relation(fields: [actorId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, actorId, conversationKey, expiresAt])
  @@index([expiresAt])
}

model WorkspaceRepository {
  id                   String    @id @default(cuid())
  workspaceId          String
  providerRepositoryId String
  enabled              Boolean   @default(true)
  createdAt            DateTime  @default(now())
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, providerRepositoryId])
}

model Invocation {
  id              String           @id @default(cuid())
  source          InvocationSource
  workspaceId     String
  actorId         String
  conversationKey String
  anchor          InvocationAnchor
  instruction     String
  repositoryId    String?
  sourceEventId   String
  receivedAt      DateTime
  createdAt       DateTime         @default(now())
  job             Job?
  larkMessage     LarkMessage?
  larkToolOperations LarkToolOperation[]

  @@unique([source, sourceEventId], map: "invocations_source_event_id_key")
  @@index([workspaceId, conversationKey])
}

model LarkToolOperation {
  id           String @id @default(cuid())
  invocationId String
  operationKey String @unique
  action       String
  targetHash   String
  payloadHash  String
  snapshotEncrypted String
  providerResultEncrypted String?
  state        LarkToolOperationState @default(CLAIMED)
  createdAt    DateTime @default(now())
  finishedAt   DateTime?
  invocation   Invocation @relation(fields: [invocationId], references: [id], onDelete: Cascade)

  @@index([invocationId, createdAt])
}

model LarkMessage {
  id                 String            @id @default(cuid())
  invocationId       String            @unique
  appId              String
  tenantKey          String
  chatId             String
  messageId          String
  senderOpenId       String
  chatType           LarkChatType
  acknowledgement    LarkDeliveryState @default(PENDING)
  acknowledgementAt  DateTime?
  finalReply         LarkDeliveryState @default(PENDING)
  finalReplyAt       DateTime?
  finalReplyMessageId String?
  finalText          String?
  processingState    LarkProcessingState @default(QUEUED)
  processingStartedAt DateTime?
  processingFinishedAt DateTime?
  createdAt          DateTime @default(now())
  invocation         Invocation        @relation(fields: [invocationId], references: [id], onDelete: Cascade)

  @@unique([appId, tenantKey, messageId])
  @@index([appId, tenantKey, chatId])
  @@index([processingState, processingStartedAt])
  @@index([processingState, createdAt])
}

model Job {
  id                   String    @id @default(cuid())
  invocationId         String    @unique
  conversationKey String
  idempotencyKey       String    @unique
  capabilityId         String?
  capabilityPolicyHash String?
  capabilityPolicy     Json?
  status               JobStatus @default(QUEUED)
  currentAttemptNumber Int       @default(0)
  cancelledAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  invocation           Invocation @relation(fields: [invocationId], references: [id], onDelete: Cascade)
  attempts             JobAttempt[]
  outboxEvents         OutboxEvent[]

  @@index([conversationKey, status])
  @@index([capabilityId])
}

model JobAttempt {
  id         String        @id @default(cuid())
  jobId      String
  number     Int
  status     AttemptStatus @default(RUNNING)
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  job        Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  execution  Execution?

  @@unique([jobId, number])
  @@index([jobId, status])
}

model Execution {
  id              String                    @id @default(cuid())
  attemptId       String                    @unique
  status          ExecutionStatus           @default(RUNNING)
  externalRunId   BigInt?                   @unique
  externalRunAttempt Int?
  bootstrapCapabilityHash String?
  bootstrapExpiresAt DateTime?
  bootstrapUsedAt  DateTime?
  capabilityId      String?
  capabilityPolicyHash String?
  capabilityPolicy  Json?
  externalUrl     String?
  reason          String?
  failureCategory ExecutionFailureCategory?
  retryable       Boolean                   @default(false)
  logProvider     ExecutionLogProvider?
  logReference    String?
  logExpiresAt    DateTime?
  testSummary     Json?
  reportedAt      DateTime?
  startedAt       DateTime                  @default(now())
  finishedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  attempt         JobAttempt                @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  events          ExecutionEvent[]
  artifacts       ExecutionArtifact[]
  callbackClaim   ExecutionCallbackClaim?
  cancellationRequest ExecutionCancellationRequest?

  @@index([status, startedAt])
  @@index([bootstrapExpiresAt])
  @@index([capabilityId])
}

model ExecutionCancellationRequest {
  id                 String                             @id @default(cuid())
  executionId        String                             @unique
  requestedAt        DateTime                           @default(now())
  requestedByActorId String
  status             ExecutionCancellationRequestStatus @default(REQUESTED)
  attemptCount       Int                                @default(0)
  lastError          String?
  lastAttemptAt      DateTime?
  execution          Execution                          @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([status, requestedAt])
}

model ExecutionEvent {
  id          String             @id @default(cuid())
  executionId String
  sequence    Int
  type        ExecutionEventType
  payload     Json
  createdAt   DateTime           @default(now())
  execution   Execution          @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, sequence])
  @@index([executionId, createdAt])
}

model ExecutionArtifact {
  id          String                @id @default(cuid())
  executionId String
  name        ExecutionArtifactName
  value       String
  createdAt   DateTime              @default(now())
  execution   Execution             @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, name])
}

model ExecutionCallbackClaim {
  id          String    @id @default(cuid())
  executionId String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model OutboxEvent {
  id            String         @id @default(cuid())
  jobId         String
  kind          OutboxEventKind
  queueSequence Int            @default(0)
  dedupeKey     String         @unique
  availableAt   DateTime       @default(now())
  createdAt     DateTime       @default(now())
  publishedAt   DateTime?
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, kind, queueSequence])
  @@index([publishedAt, createdAt])
}

model CredentialClaim {
  id                  String             @id @default(cuid())
  workspaceId         String
  actorId             String
  attemptId           String
  provider            CredentialProvider
  credentialReference String
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime           @default(now())

  @@index([workspaceId, actorId, attemptId])
  @@index([expiresAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  jobId       String?
  attemptId   String?
  action      String
  metadata    Json
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([jobId, createdAt])
}
